BOT_TOKEN=bot_token
BOT_USERNAME=godofdars_bot
ADMIN_BOT_TOKEN=admin_bot_token

# Comma-separated Telegram user IDs allowed to use the admin bot.
ADMIN_IDS=123456789

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/godofdars

# PostgreSQL connection pool. Increase only together with PostgreSQL max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Backpressure for incoming updates and Telegram HTTP requests.
BOT_CONCURRENCY_LIMIT=100
ADMIN_CONCURRENCY_LIMIT=10
TELEGRAM_HTTP_LIMIT=100
# Bound concurrent Bot API calls; keep below Telegram and database capacity.
TELEGRAM_API_CONCURRENCY=30
TELEGRAM_RETRY_AFTER_MAX=3
WORKER_COUNT=4
WORKER_POLL_INTERVAL=2
WORKER_BATCH_SIZE=100
BROADCAST_BATCH_SIZE=100
TELEGRAM_SEND_DELAY=0.04
MEMBERSHIP_CACHE_TTL=60
MEMBERSHIP_CACHE_MAX_ENTRIES=10000
CHANNELS_CACHE_TTL=30
GROUP_REGISTER_CACHE_TTL=300

ENVIRONMENT=development
# Required subscription channels are managed from the admin panel, not .env.

# Public API and Telegram OIDC. Configure Login Widget / Allowed URLs in BotFather.
API_PUBLIC_BASE_URL=https://api.example.com
API_ALLOWED_ORIGINS=https://app.example.com
API_JWT_SECRET=replace_with_at_least_32_random_bytes
API_JWT_ISSUER=godofdars-api
API_JWT_AUDIENCE=godofdars-flet
API_ACCESS_TOKEN_MINUTES=15
API_REFRESH_TOKEN_DAYS=30
API_LOGIN_ATTEMPT_MINUTES=10
API_IDEMPOTENCY_HOURS=24
API_CLEANUP_INTERVAL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
# Optional, for example socks5://127.0.0.1:10808
API_OUTBOUND_PROXY=
TELEGRAM_CLIENT_ID=123456789
TELEGRAM_CLIENT_SECRET=telegram_oidc_client_secret
TELEGRAM_REDIRECT_URI=https://api.example.com/api/v1/auth/telegram/callback
TELEGRAM_OIDC_SCOPES=openid profile telegram:bot_access

TELEGRAM_PROXY=http://127.0.0.1:10808
