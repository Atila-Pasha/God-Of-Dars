BOT_TOKEN=bot_token
ADMIN_BOT_TOKEN=admin_bot_token

# Comma-separated Telegram user IDs allowed to use the admin bot.
ADMIN_IDS=123456789

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/godofdars

# PostgreSQL connection pool. Increase only together with PostgreSQL max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Backpressure for incoming updates and Telegram HTTP requests.
BOT_CONCURRENCY_LIMIT=100
ADMIN_CONCURRENCY_LIMIT=10
TELEGRAM_HTTP_LIMIT=100
WORKER_COUNT=4
WORKER_POLL_INTERVAL=2
WORKER_BATCH_SIZE=100
BROADCAST_BATCH_SIZE=100
TELEGRAM_SEND_DELAY=0.04
MEMBERSHIP_CACHE_TTL=60
MEMBERSHIP_CACHE_MAX_ENTRIES=10000
CHANNELS_CACHE_TTL=30
GROUP_REGISTER_CACHE_TTL=300

ENVIRONMENT=development
# Required subscription channels are managed from the admin panel, not .env.

TELEGRAM_PROXY=http://127.0.0.1:10808
