BOT_TOKEN=bot_token
BOT_USERNAME=godofdars_bot
ADMIN_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the admin bot.
ADMIN_IDS=

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/godofdars

# Used by compose.yaml. Always replace this value before deployment.
POSTGRES_USER=godofdars
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=godofdars

# PostgreSQL connection pool. Increase only together with PostgreSQL max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Backpressure for incoming updates and Telegram HTTP requests.
BOT_CONCURRENCY_LIMIT=100
ADMIN_CONCURRENCY_LIMIT=10
TELEGRAM_HTTP_LIMIT=100
# Bound concurrent Bot API calls; keep below Telegram and database capacity.
TELEGRAM_API_CONCURRENCY=30
TELEGRAM_RETRY_AFTER_MAX=3
WORKER_COUNT=4
NOTIFICATION_WORKER_COUNT=4
# Parallel notification sends per worker. The process-wide Telegram limiter
# remains the final safety cap for all Bot API requests.
NOTIFICATION_SEND_CONCURRENCY=20
WORKER_POLL_INTERVAL=2
WORKER_BATCH_SIZE=100
BROADCAST_BATCH_SIZE=100
TELEGRAM_SEND_DELAY=0.04
MEMBERSHIP_CACHE_TTL=60
MEMBERSHIP_CACHE_MAX_ENTRIES=10000
CHANNELS_CACHE_TTL=30
GROUP_REGISTER_CACHE_TTL=300
GROUP_REGISTER_CACHE_MAX_ENTRIES=10000
# Avoid a database read for every message from recently seen group members.
GROUP_USER_CACHE_TTL=60
GROUP_USER_CACHE_MAX_ENTRIES=50000
# Calendar boundaries for daily/weekly/monthly leaderboards.
LEADERBOARD_TIMEZONE=Asia/Tehran

ENVIRONMENT=development
# Required subscription channels are managed from the admin panel, not .env.

# Optional, for example http://127.0.0.1:10808
TELEGRAM_PROXY=
